{
  "name": "@plotbench/results",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "format": "prettier --write index.html src scripts tests/*.ts *.ts *.json",
    "format:check": "prettier --check index.html src scripts tests/*.ts *.ts *.json",
    "dev": "npm run catalog && vite --host 127.0.0.1",
    "catalog": "node --import tsx scripts/catalog.ts",
    "validate": "node --import tsx scripts/catalog.ts --check",
    "export": "node --import tsx scripts/export.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run catalog && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prettier": "3.8.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "license": "BSD-3-Clause"
}
