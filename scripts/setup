#!/usr/bin/env bash
set -euo pipefail
PLOTBENCH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PLOTBENCH_ROOT"
export UV_CACHE_DIR="$PLOTBENCH_ROOT/.cache/uv"
export UV_PYTHON_INSTALL_DIR="$PLOTBENCH_ROOT/.envs/python"
export PLAYWRIGHT_BROWSERS_PATH="$PLOTBENCH_ROOT/.cache/playwright"
PLOTBENCH_COMPONENT="${1:-all}"
case "$PLOTBENCH_COMPONENT" in
  all|core|rust|pyqtgraph|pyqtgraph-gl|matplotlib|qtgraphs|qtgraphs-cpp|iced|plotly) ;;
  *) echo "Usage: ./scripts/setup [all|core|rust|pyqtgraph|pyqtgraph-gl|matplotlib|qtgraphs|qtgraphs-cpp|iced|plotly]" >&2; exit 2 ;;
esac
command -v uv >/dev/null || { echo 'Install uv first: https://docs.astral.sh/uv/getting-started/installation/' >&2; exit 1; }
uv python install 3.13.14 --no-bin
UV_PROJECT_ENVIRONMENT="$PLOTBENCH_ROOT/.envs/plotting-benchmark" uv sync --project core --python 3.13.14 --locked
for PLOTBENCH_PACKAGE in pyqtgraph matplotlib qtgraphs; do
  if [[ "$PLOTBENCH_COMPONENT" == all || "$PLOTBENCH_COMPONENT" == "$PLOTBENCH_PACKAGE" || ( "$PLOTBENCH_COMPONENT" == pyqtgraph-gl && "$PLOTBENCH_PACKAGE" == pyqtgraph ) ]]; then
    UV_PROJECT_ENVIRONMENT="$PLOTBENCH_ROOT/.envs/plotting-benchmark-$PLOTBENCH_PACKAGE" uv sync --project "frontends/$PLOTBENCH_PACKAGE" --python 3.13.14 --locked
  fi
done
if [[ "$PLOTBENCH_COMPONENT" == all || "$PLOTBENCH_COMPONENT" == plotly ]]; then
  command -v npm >/dev/null || { echo 'Node/npm are required to bootstrap the isolated JavaScript toolchain.' >&2; exit 1; }
  if [[ ! -x "$PLOTBENCH_ROOT/.envs/node/node_modules/node/bin/node" ]]; then
    npm install --prefix "$PLOTBENCH_ROOT/.envs/node" --cache "$PLOTBENCH_ROOT/.cache/npm" --no-audit --no-fund node@24.19.0
  fi
  export PATH="$PLOTBENCH_ROOT/.envs/node/node_modules/node/bin:$PATH"
  npm ci --prefix frontends/plotly --cache "$PLOTBENCH_ROOT/.cache/npm" --no-audit --no-fund
  npm run build --prefix frontends/plotly
  .envs/plotting-benchmark/bin/python -m plotbench.provenance plotly
  .envs/plotting-benchmark/bin/python -m playwright install chromium
fi
if [[ "$PLOTBENCH_COMPONENT" == all || "$PLOTBENCH_COMPONENT" == iced ]]; then
  command -v cargo >/dev/null || { echo 'Rust/Cargo is required: https://rustup.rs/' >&2; exit 1; }
  CARGO_HOME="$PLOTBENCH_ROOT/frontends/iced/.cargo-cache" cargo build --release --locked --manifest-path frontends/iced/Cargo.toml
  .envs/plotting-benchmark/bin/python -m plotbench.provenance iced
fi
if [[ "$PLOTBENCH_COMPONENT" == all || "$PLOTBENCH_COMPONENT" == rust ]]; then
  command -v cargo >/dev/null || { echo 'Rust/Cargo is required: https://rustup.rs/' >&2; exit 1; }
  CARGO_HOME="$PLOTBENCH_ROOT/backends/rust/.cargo-cache" cargo build --release --locked --manifest-path backends/rust/Cargo.toml
  .envs/plotting-benchmark/bin/python -m plotbench.provenance rust
fi
if [[ "$PLOTBENCH_COMPONENT" == all || "$PLOTBENCH_COMPONENT" == qtgraphs-cpp ]]; then
  # A Qt 6 C++ SDK with the Graphs, Quick, QuickControls2, Network and WebSockets modules is a
  # bootstrap tool like uv/Cargo. Set PLOTBENCH_QT_PREFIX to choose one explicitly.
  if [[ -z "${PLOTBENCH_QT_PREFIX:-}" ]]; then
    for PLOTBENCH_QT_CANDIDATE in "$HOME"/Qt/6.*/macos /opt/homebrew/opt/qt; do
      if [[ -x "$PLOTBENCH_QT_CANDIDATE/bin/qt-cmake" && -d "$PLOTBENCH_QT_CANDIDATE/lib/cmake/Qt6Graphs" ]]; then
        PLOTBENCH_QT_PREFIX="$PLOTBENCH_QT_CANDIDATE"
      fi
    done
  fi
  if [[ -z "${PLOTBENCH_QT_PREFIX:-}" || ! -x "$PLOTBENCH_QT_PREFIX/bin/qt-cmake" ]]; then
    if [[ "$PLOTBENCH_COMPONENT" == all ]]; then
      echo 'Skipping qtgraphs-cpp: no Qt 6 C++ SDK with Qt Graphs found (set PLOTBENCH_QT_PREFIX).' >&2
    else
      echo 'qtgraphs-cpp needs a Qt 6 C++ SDK with Qt Graphs and WebSockets; set PLOTBENCH_QT_PREFIX to its prefix.' >&2
      exit 1
    fi
  else
    command -v cmake >/dev/null || { echo 'CMake is required for qtgraphs-cpp.' >&2; exit 1; }
    PLOTBENCH_GENERATOR=()
    command -v ninja >/dev/null && PLOTBENCH_GENERATOR=(-G Ninja)
    "$PLOTBENCH_QT_PREFIX/bin/qt-cmake" -S frontends/qtgraphs-cpp -B frontends/qtgraphs-cpp/build \
      "${PLOTBENCH_GENERATOR[@]}" -DCMAKE_BUILD_TYPE=Release
    cmake --build frontends/qtgraphs-cpp/build --config Release
    .envs/plotting-benchmark/bin/python -m plotbench.provenance qtgraphs-cpp
  fi
fi
echo "Ready. Start a demo: ./scripts/plotbench demo pyqtgraph"
