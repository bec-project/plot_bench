#!/usr/bin/env bash
set -euo pipefail
PLOTBENCH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PLOTBENCH_ROOT"
export UV_CACHE_DIR="${UV_CACHE_DIR:-$PLOTBENCH_ROOT/.cache/uv}"
export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-$PLOTBENCH_ROOT/.envs/python}"
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-$PLOTBENCH_ROOT/.cache/playwright}"
PLOTBENCH_COMPONENTS=()
PLOTBENCH_DEV=(--no-dev)
PLOTBENCH_BROWSER=bundled
usage() {
  echo 'Usage: ./scripts/setup [core|rust|pyqtgraph|pyqtgraph-gl|matplotlib|qtgraphs|qtgraphs-cpp|iced|plotly|all]... [--dev] [--browser bundled|system]'
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --dev) PLOTBENCH_DEV=(--group dev) ;;
    --browser)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      shift; PLOTBENCH_BROWSER="$1"
      [[ "$1" == bundled || "$1" == system ]] || { usage >&2; exit 2; }
      ;;
    all) PLOTBENCH_COMPONENTS+=(core rust pyqtgraph matplotlib qtgraphs qtgraphs-cpp iced plotly) ;;
    core|rust|pyqtgraph|matplotlib|qtgraphs|qtgraphs-cpp|iced|plotly) PLOTBENCH_COMPONENTS+=("$1") ;;
    pyqtgraph-gl) PLOTBENCH_COMPONENTS+=(pyqtgraph) ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done
[[ ${#PLOTBENCH_COMPONENTS[@]} -gt 0 ]] || PLOTBENCH_COMPONENTS=(core)
selected() { [[ " ${PLOTBENCH_COMPONENTS[*]} " == *" $1 "* ]]; }
PLOTBENCH_PYTHON_VERSION="$(<.python-version)"
PLOTBENCH_NODE_VERSION="$(<.node-version)"
PLOTBENCH_UV_MIN_VERSION="$(<.uv-version)"
PLOTBENCH_UV_BIN="$(command -v "${PLOTBENCH_UV:-uv}")" || {
  echo "uv executable not found: ${PLOTBENCH_UV:-uv}. Install uv: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 1
}
PLOTBENCH_UV_VERSION="$("$PLOTBENCH_UV_BIN" --version)"
PLOTBENCH_UV_VERSION="${PLOTBENCH_UV_VERSION#uv }"
PLOTBENCH_UV_VERSION="${PLOTBENCH_UV_VERSION%% *}"
# uv embeds its Python download catalog; an old uv cannot install a newer pin.
# Check without Python so this also works before any environments exist.
if ! awk -v installed="$PLOTBENCH_UV_VERSION" -v required="$PLOTBENCH_UV_MIN_VERSION" '
  BEGIN {
    if (installed !~ /^[0-9]+\.[0-9]+\.[0-9]+$/) exit 1
    split(installed, actual, "."); split(required, minimum, ".")
    for (i = 1; i <= 3; i++) {
      if (actual[i] + 0 > minimum[i] + 0) exit 0
      if (actual[i] + 0 < minimum[i] + 0) exit 1
    }
    exit 0
  }'; then
  echo "Setup requires uv >= $PLOTBENCH_UV_MIN_VERSION (see .uv-version); found $PLOTBENCH_UV_VERSION at $PLOTBENCH_UV_BIN." >&2
  echo 'Update standalone uv with "uv self update", or update it through the package manager that installed it.' >&2
  echo 'If multiple copies exist, check "type -a uv" and select one with PLOTBENCH_UV=/path/to/uv ./scripts/setup ...' >&2
  exit 1
fi
echo "Using uv $PLOTBENCH_UV_VERSION at $PLOTBENCH_UV_BIN"
"$PLOTBENCH_UV_BIN" python install "$PLOTBENCH_PYTHON_VERSION" --no-bin
# The core environment is the CLI/TUI entry point, so it always includes the TUI.
PLOTBENCH_CORE_ARGS=(--locked --inexact --extra tui)
selected plotly && PLOTBENCH_CORE_ARGS+=(--extra browser)
# Preserve previously installed optional components when adding another frontend.
UV_PROJECT_ENVIRONMENT="$PLOTBENCH_ROOT/.envs/plotting-benchmark" "$PLOTBENCH_UV_BIN" sync --project core \
  --python "$PLOTBENCH_PYTHON_VERSION" "${PLOTBENCH_CORE_ARGS[@]}" "${PLOTBENCH_DEV[@]}"
for PLOTBENCH_PACKAGE in pyqtgraph matplotlib qtgraphs; do
  if selected "$PLOTBENCH_PACKAGE"; then
    UV_PROJECT_ENVIRONMENT="$PLOTBENCH_ROOT/.envs/plotting-benchmark-$PLOTBENCH_PACKAGE" "$PLOTBENCH_UV_BIN" sync \
      --project "frontends/$PLOTBENCH_PACKAGE" --python "$PLOTBENCH_PYTHON_VERSION" --locked --inexact "${PLOTBENCH_DEV[@]}"
  fi
done
if selected plotly; then
  command -v npm >/dev/null || { echo 'Node/npm are required to bootstrap the JavaScript toolchain.' >&2; exit 1; }
  PLOTBENCH_NODE="$PLOTBENCH_ROOT/.envs/node/node_modules/node/bin/node"
  if [[ ! -x "$PLOTBENCH_NODE" ]] || [[ "$("$PLOTBENCH_NODE" --version)" != "v$PLOTBENCH_NODE_VERSION" ]]; then
    npm install --prefix "$PLOTBENCH_ROOT/.envs/node" --cache "$PLOTBENCH_ROOT/.cache/npm" \
      --no-audit --no-fund "node@$PLOTBENCH_NODE_VERSION"
  fi
  export PATH="$(dirname "$PLOTBENCH_NODE"):$PATH"
  npm ci --prefix frontends/plotly --cache "$PLOTBENCH_ROOT/.cache/npm" --no-audit --no-fund
  npm run build --prefix frontends/plotly
  .envs/plotting-benchmark/bin/python -m plotbench.provenance plotly
  if [[ "$PLOTBENCH_BROWSER" == bundled ]]; then
    .envs/plotting-benchmark/bin/python -m playwright install chromium
  else
    echo 'Use --browser-executable /path/to/chromium with doctor, demo and run.'
  fi
fi
for PLOTBENCH_NATIVE in iced rust; do
  if selected "$PLOTBENCH_NATIVE"; then
    command -v cargo >/dev/null || { echo 'Install Rust/Cargo using https://rustup.rs/' >&2; exit 1; }
    PLOTBENCH_NATIVE_DIR="frontends/$PLOTBENCH_NATIVE"
    [[ "$PLOTBENCH_NATIVE" != rust ]] || PLOTBENCH_NATIVE_DIR=backends/rust
    CARGO_HOME="${CARGO_HOME:-$PLOTBENCH_ROOT/.cache/cargo}" \
      CARGO_TARGET_DIR="$PLOTBENCH_ROOT/$PLOTBENCH_NATIVE_DIR/target" \
      cargo build --release --locked --manifest-path "$PLOTBENCH_NATIVE_DIR/Cargo.toml"
    .envs/plotting-benchmark/bin/python -m plotbench.provenance "$PLOTBENCH_NATIVE"
  fi
done
if selected qtgraphs-cpp; then
  command -v cmake >/dev/null || { echo 'CMake is required for qtgraphs-cpp.' >&2; exit 1; }
  PLOTBENCH_CMAKE=(cmake)
  PLOTBENCH_CMAKE_ARGS=(-DCMAKE_BUILD_TYPE=Release)
  if [[ -n "${PLOTBENCH_QT_PREFIX:-}" ]]; then
    [[ -d "$PLOTBENCH_QT_PREFIX" ]] || { echo 'PLOTBENCH_QT_PREFIX must name an installed Qt SDK directory.' >&2; exit 1; }
    PLOTBENCH_CMAKE_ARGS+=("-DCMAKE_PREFIX_PATH=$PLOTBENCH_QT_PREFIX")
    [[ ! -x "$PLOTBENCH_QT_PREFIX/bin/qt-cmake" ]] || PLOTBENCH_CMAKE=("$PLOTBENCH_QT_PREFIX/bin/qt-cmake")
  elif command -v qt-cmake >/dev/null; then
    PLOTBENCH_CMAKE=(qt-cmake)
  fi
  if [[ ! -f frontends/qtgraphs-cpp/build/CMakeCache.txt ]] && command -v ninja >/dev/null; then
    PLOTBENCH_CMAKE_ARGS+=(-G Ninja)
  fi
  if ! "${PLOTBENCH_CMAKE[@]}" -S frontends/qtgraphs-cpp -B frontends/qtgraphs-cpp/build \
    "${PLOTBENCH_CMAKE_ARGS[@]}"; then
    echo 'Qt C++ needs Qt 6.8+ with Graphs, Quick, QuickControls2, Network, WebSockets, Test and (on Linux) WaylandClient. Set PLOTBENCH_QT_PREFIX or CMAKE_PREFIX_PATH; see docs/setup.md.' >&2
    exit 1
  fi
  cmake --build frontends/qtgraphs-cpp/build --config Release
  .envs/plotting-benchmark/bin/python -m plotbench.provenance qtgraphs-cpp
fi
echo 'Setup complete. Check selected runtimes with ./scripts/plotbench doctor --frontends <names>.'
