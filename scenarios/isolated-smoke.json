{
  "name": "Separate waveform and image smoke validation",
  "description": "Waveform-only and image-only smoke runs kept separate, so a failure points at one plot type. One repetition, stream and replay.",
  "warmup_seconds": 1,
  "measurement_seconds": 3,
  "repetitions": 1,
  "cooldown_seconds": 0.5,
  "order_seed": 42,
  "frontends": ["pyqtgraph", "pyqtgraph-gl", "matplotlib", "qtgraphs", "iced", "plotly"],
  "modes": ["stream", "replay"],
  "cases": [
    {"name": "waveform-only-60hz", "config": {"view": "waveform", "hz": 60, "points": 10000, "append_count": 1000, "waveform_mode": "replace"}},
    {"name": "scalar-image-only-60hz", "config": {"view": "image", "hz": 60, "width": 512, "height": 512, "image_mode": "scalar"}},
    {"name": "rgb-image-only-60hz", "config": {"view": "image", "hz": 60, "width": 256, "height": 256, "image_mode": "rgb"}}
  ]
}
