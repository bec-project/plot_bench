  "cases": [
    {"name": "waveform-10k-120hz", "config": {"view": "waveform", "hz": 120, "points": 10000}},
    {"name": "waveform-1m-120hz", "config": {"view": "waveform", "hz": 120, "points": 1000000}},
    {"name": "scalar-2048-120hz", "config": {"view": "image", "hz": 120, "width": 2048, "height": 2048, "image_mode": "scalar"}},
    {"name": "rgb-2048-120hz", "config": {"view": "image", "hz": 120, "width": 2048, "height": 2048, "image_mode": "rgb"}}
  ]
}
