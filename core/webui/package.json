{
  "name": "@plotbench/webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.10.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:matrix && npm run build:controls",
    "build:matrix": "vite build",
    "build:controls": "vite build --config vite.controls.config.ts && cp dist/controls.html ../src/plotbench/controls.html",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "license": "BSD-3-Clause"
}
